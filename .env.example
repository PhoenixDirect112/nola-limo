# ─────────────────────────────────────────────────────────────────
#  NOLA LIMO — Environment Variables
#  Copy this file to .env.local for local dev (never commit .env)
#  Set all values in Netlify Dashboard → Site → Environment Variables
# ─────────────────────────────────────────────────────────────────

# ── Square ────────────────────────────────────────────────────────
# Get from: https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_LOCATION_ID=your_square_location_id_here
SQUARE_ENVIRONMENT=sandbox   # Change to "production" when live

# ── Microsoft Azure / Graph API ───────────────────────────────────
# Get from: https://portal.azure.com → App Registrations
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
AZURE_TENANT_ID=your_azure_tenant_id_here
# The driver's Outlook/Microsoft 365 email address
OUTLOOK_USER_EMAIL=driver@yourdomain.com

# ── App Security ──────────────────────────────────────────────────
# Generate a random 32-char string: openssl rand -hex 32
SESSION_SECRET=replace_with_random_32char_string
# Your deployed Netlify URL (no trailing slash)
SITE_URL=https://your-site.netlify.app
